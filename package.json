{
  "name": "funded-projects-erp",
  "version": "0.16.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "demo": "node --env-file-if-exists=.env scripts/demo.js",
    "init": "node --env-file-if-exists=.env scripts/init.js",
    "test:browser": "node scripts/browser-smoke.js && node scripts/browser-lifecycle.js && node scripts/browser-completion.js && node scripts/browser-payroll-inventory.js && node scripts/browser-stage3.js && node scripts/browser-employee-registration.js && node scripts/browser-accounting.js && node scripts/browser-people.js && node scripts/browser-operations.js && node scripts/browser-release.js && node scripts/browser-stage7.js && node scripts/browser-organization-finance.js && node scripts/browser-finance-usability.js && node scripts/browser-guided-workflows.js && node scripts/browser-dashboard.js && node scripts/browser-workspace-journeys.js && node scripts/browser-leave-journey.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "check": "node scripts/check.js",
    "worker": "node --env-file-if-exists=.env scripts/worker.js",
    "preflight": "node --env-file-if-exists=.env scripts/preflight.js",
    "test:load": "node scripts/load-check.js",
    "setup:env": "node scripts/setup-env.js",
    "demo:stage3": "node --env-file-if-exists=.env scripts/demo-stage3.js",
    "demo:accounting": "node --env-file-if-exists=.env scripts/demo-accounting.js",
    "test:accounting": "node --test --test-concurrency=1 tests/accounting*.test.js",
    "test:people": "node --test --test-concurrency=1 tests/people*.test.js",
    "demo:people": "node --env-file-if-exists=.env scripts/demo-people.js",
    "build:vercel": "node scripts/build-vercel.js",
    "test:operations": "node --test --test-concurrency=1 tests/operations*.test.js",
    "backup:encrypted": "node --env-file-if-exists=.env scripts/backup-encrypted.js",
    "restore:encrypted": "node --env-file-if-exists=.env scripts/restore-encrypted.js",
    "test:release": "node --test --test-concurrency=1 tests/release-*.test.js",
    "verify:recovery": "node scripts/verify-release-recovery.js",
    "test:performance": "node scripts/release-performance.js",
    "verify:upgrade": "node scripts/verify-release-upgrade.js",
    "uat": "node scripts/uat.js",
    "verify:financials": "node scripts/verify-release-financials.js",
    "verify:coverage": "node scripts/release-evidence.js",
    "test:stage7": "node --test --test-concurrency=1 tests/stage7*.test.js",
    "stage7:inventory": "node scripts/stage7-inventory.js",
    "staging:probe": "node scripts/staging-probe.js",
    "uat:resume": "node scripts/resume-uat.js",
    "test:organization": "node --test --test-concurrency=1 tests/organization*.test.js",
    "demo:organization": "node scripts/organization-demo.js",
    "demo:organization:resume": "node scripts/organization-demo.js --resume",
    "build:postgres": "node scripts/build-postgres-runtime.js",
    "migrate:postgres": "node --env-file-if-exists=.env scripts/postgres-migrate.js",
    "backup:postgres": "node --env-file-if-exists=.env scripts/postgres-tools.js backup",
    "restore:postgres": "node --env-file-if-exists=.env scripts/postgres-tools.js restore",
    "preflight:postgres": "node --env-file-if-exists=.env scripts/postgres-tools.js preflight",
    "verify:postgres:recovery": "node scripts/verify-postgres-recovery.js",
    "setup:postgres:tests": "node scripts/setup-postgres-tests.js",
    "test:postgres": "node scripts/run-postgres-tests.js",
    "test:postgres:browser": "node scripts/run-postgres-tests.js --browser",
    "test:postgres:contracts": "node --test --test-concurrency=1 tests/postgres/contracts.test.js",
    "demo:postgres": "node scripts/postgres-local-staging.js",
    "package:postgres:staging": "node scripts/package-postgres-staging.js",
    "test:browser:finance": "node scripts/browser-organization-finance.js && node scripts/browser-finance-usability.js",
    "test:browser:guided": "node scripts/browser-guided-workflows.js && node scripts/browser-employee-registration.js",
    "test:dashboard": "node --test --test-concurrency=1 tests/dashboard.test.js",
    "test:browser:dashboard": "node scripts/browser-dashboard.js",
    "test:performance:dashboard": "node scripts/dashboard-performance.js",
    "test:experience": "node --test --test-concurrency=1 tests/workspace-experience.test.js tests/dashboard.test.js",
    "test:browser:experience": "node scripts/browser-workspace-journeys.js && node scripts/browser-guided-workflows.js && node scripts/browser-leave-journey.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "nodemailer": "10.1.4",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1"
  }
}
