# Run npm run setup:env to create .env without overwriting an existing file.
# Application commands load .env; existing process environment takes precedence.
HOST=127.0.0.1
PORT=3000
ERP_DB=data/erp.sqlite
# Local saved database. Use deploy/supabase.env.example for private PostgreSQL staging.
ERP_DATABASE_PROVIDER=sqlite
# PostgreSQL: backend-only URL/record-key files, verified TLS, direct/session connection.
# ERP_POSTGRES_URL_FILE=/run/secrets/staging_postgres_url
# ERP_POSTGRES_SCHEMA=erp_private
# ERP_POSTGRES_TLS=true
# ERP_POSTGRES_CONNECTION_MODE=direct
# ERP_POSTGRES_CA_FILE=/run/secrets/supabase_ca.pem
# PostgreSQL requires max_locks_per_transaction>=512; it never falls back to ERP_DB.
# Private staging: blocks external provider calls and automatic erasure.
# ERP_STAGING_SYNTHETIC_ONLY=true
# Optional single-account password-only exception for synthetic staging, with transports=false.
# ERP_STAGING_PASSWORD_ONLY_ADMIN_EMAIL=staging-admin@example.test
# Enrollment removal is a separate audited operation; organization MFA policies still apply.
ERP_TIMEZONE=Africa/Mogadishu
ERP_SECURE_COOKIES=false
# Production only: actual HTTPS origin and protected external 64-hex-character key file.
# ERP_PUBLIC_ORIGIN=https://your-domain
# ERP_MASTER_KEY_FILE=/run/secrets/erp_master_key
# Background inbox scan. Setup enables this only for the known local demo admin.
ERP_JOBS_ENABLED=false
ERP_JOB_INTERVAL_SECONDS=300
# ERP_WORKER_USER=
# External delivery requires this explicit opt-in AND configured providers.
ERP_TRANSPORTS_ENABLED=false
# Optional SMTP provider settings; absent host means no external email.
# ERP_SMTP_HOST=
# ERP_SMTP_PORT=587
# ERP_SMTP_FROM=
# ERP_SMTP_USER=
# ERP_SMTP_PASSWORD=
# ERP_SMTP_SECURE=false
# Optional organization sign-in; absent settings keep it disabled.
# ERP_OIDC_ISSUER=
# ERP_OIDC_CLIENT_ID=
# ERP_OIDC_CLIENT_SECRET=
# ERP_OIDC_REDIRECT_URI=https://your-domain/api/oidc/callback
# Only attest after actual target verification and organizational signoff.
# ERP_POLICY_SIGNOFF=true
# ERP_DEPLOYMENT_VERIFIED=true

# Stage 3 payroll example is a separate local database, never a reset of existing data.
# Create it with npm.cmd run demo:stage3 -- data/stage3-demo.sqlite (new path only).
# To view it separately, override ERP_DB=data/stage3-demo.sqlite and PORT=3001.
# Configure Somaliland statutory/leave policies in HR management; provisional rules block finalization.

# Stage 5 employee lifecycle uses the same USD database, encryption and notification worker.
# New sample: npm.cmd run demo:people -- data/unused-people-demo.sqlite (unused path only).
# Configure hiring/moderator/access roles and final-pay policy in Employee lifecycle.
# External calendar/account provisioning is unconfigured; transports stay disabled by default.

# Operational completion: credential values belong only on the persistent backend.
# Configure SCIM / CalDAV HTTPS endpoints in Employee lifecycle > Policies & controls.
# ERP_SCIM_TOKEN=
# ERP_CALDAV_TOKEN=
# Each connection may use its own ERP_SCIM_TOKEN_SUFFIX / ERP_CALDAV_TOKEN_SUFFIX.
# Vercel serves public assets and proxies /api to the persistent Node API.
# Selected staging: Node API on a separate host, using Supabase PostgreSQL.
# Vercel build environment (actual backend HTTPS origin, without a path):
# ERP_BACKEND_ORIGIN=https://backend.your-domain
# Set this in the Vercel project settings; the local .env is not uploaded.
# Use the Node API origin, not the Supabase database/project URL or localhost.
# Both Vercel runtime and backend: identical randomly generated proxy secret.
# ERP_PROXY_SECRET=
# Backend: public Vercel/custom domain, secure cookies, external key in production.
# ERP_PUBLIC_ORIGIN=https://erp.your-domain
# ERP_SECURE_COOKIES=true
# Never upload data/, .env, database keys or backups to Vercel.

# Stage 6: reviewed identity assurance and encrypted backup configuration.
# Production privileges require MFA; local enforcement can be enabled in Account security.
# ERP_OIDC_MFA_ACR= (actual provider-supported assurance value, not a guessed string)
# First production initialization only; use an unused private directory/file.
# ERP_ADMIN_MFA_SEED_FILE=/run/private-bootstrap/first-admin.json
# Independent backup encryption key; never reuse/include the database key in archives.
# ERP_BACKUP_KEY_FILE=/run/secrets/erp_backup_key
# ERP_BACKUP_DIR=/var/backups/erp
# ERP_BACKUP_RETENTION_DAYS=90
# ERP_BACKUP_CONFIG_FILE=/run/config/erp.env
# ERP_BACKUP_STATUS_FILE=/var/lib/erp/backup-status.json
# ERP_BACKUP_MAX_AGE_HOURS=24
# Recovery only: separately protected original database key.
# ERP_RESTORE_MASTER_KEY_FILE=/run/recovery-secrets/original_database_key

# Approved public organization identity. Leave blank until supplied by the organization.
# ERP_ORGANIZATION_NAME=
# ERP_ORGANIZATION_LOGO_FILE=C:/path/to/approved-logo.png
# PNG, JPEG or WebP only; maximum 2 MiB. Keep operational files outside source control.
