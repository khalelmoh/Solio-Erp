ERP_STAGING_SYNTHETIC_ONLY=true
PGSERVICEFILE=/etc/erp-staging/pg_service.conf
PGPASSFILE=/run/secrets/staging_pgpass
ERP_BACKUP_SERVICE=erp_staging
# Public encryption recipient; private recovery identity belongs in a separate vault.
ERP_BACKUP_AGE_RECIPIENT=
ERP_BACKUP_DIR=/var/backups/erp-staging
ERP_BACKUP_STATUS_FILE=/var/lib/erp-staging/backup-status.json
# Approved monitoring test sink only. Protected curl config includes HTTPS URL/headers.
ERP_BACKUP_ALERT_TEST_ONLY=false
# ERP_BACKUP_ALERT_CONFIG_FILE=/run/secrets/staging_backup_alert_curl.conf
