NODE_ENV=production
HOST=127.0.0.1
PORT=3000
ERP_DB=/var/lib/erp/erp.sqlite
ERP_MASTER_KEY_FILE=/run/secrets/erp_database_key
ERP_PUBLIC_ORIGIN=https://erp.example.invalid
ERP_SECURE_COOKIES=true
ERP_JOBS_ENABLED=false
ERP_TRANSPORTS_ENABLED=false
ERP_TIMEZONE=Africa/Mogadishu
ERP_BACKUP_KEY_FILE=/run/secrets/erp_backup_key
ERP_BACKUP_DIR=/var/backups/erp
ERP_BACKUP_RETENTION_DAYS=90
# Turn on workers/transports only after actual policy, account and provider approval.
# ERP_WORKER_USER=
# ERP_PROXY_SECRET= (same strong secret on Vercel runtime and persistent backend)
# ERP_ADMIN_MFA_SEED_FILE=/run/private-bootstrap/first-admin.json (initialization only)
# ERP_OIDC_MFA_ACR= (provider-supported reviewed MFA assurance value)
# These are example paths and a reserved .invalid origin, not deployment verification.
