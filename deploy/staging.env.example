NODE_ENV=production
HOST=127.0.0.1
PORT=3001
ERP_DB=/var/lib/erp-staging/erp.sqlite
ERP_MASTER_KEY_FILE=/run/secrets/staging_database_key
ERP_PUBLIC_ORIGIN=https://staging.example.invalid
ERP_SECURE_COOKIES=true
ERP_JOBS_ENABLED=false
ERP_TRANSPORTS_ENABLED=false
ERP_TIMEZONE=Africa/Mogadishu
ERP_BACKUP_KEY_FILE=/run/secrets/staging_backup_key
ERP_BACKUP_DIR=/var/backups/erp-staging
ERP_BACKUP_RETENTION_DAYS=30
# Replace .invalid origin and secret paths; retain staging isolation from production.
