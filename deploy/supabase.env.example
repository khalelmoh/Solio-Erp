# Private synthetic staging: Vercel frontend + persistent Node24 API + Supabase PostgreSQL.
# Keep the actual file outside the release, mode0600 / service-only Windows ACL.
ERP_DATABASE_PROVIDER=supabase
ERP_STAGING_SYNTHETIC_ONLY=true
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
ERP_PUBLIC_ORIGIN=https://staging.example.invalid
ERP_SECURE_COOKIES=true
ERP_TIMEZONE=Africa/Mogadishu
ERP_JOBS_ENABLED=false
ERP_TRANSPORTS_ENABLED=false
# Optional synthetic-only account exception; leave unset for ordinary production MFA enforcement.
# ERP_STAGING_PASSWORD_ONLY_ADMIN_EMAIL=staging-admin@example.test
ERP_POSTGRES_URL_FILE=/run/secrets/staging_postgres_runtime_url
ERP_POSTGRES_SCHEMA=erp_private
ERP_POSTGRES_TLS=true
ERP_POSTGRES_CONNECTION_MODE=direct
# ERP_POSTGRES_CA_FILE=/run/secrets/supabase_ca.pem
ERP_MASTER_KEY_FILE=/run/secrets/staging_record_key
ERP_BACKUP_KEY_FILE=/run/secrets/staging_independent_backup_key
ERP_BACKUP_STATUS_FILE=/var/lib/erp-staging/backup-status.json
# ERP_PROXY_SECRET= set in the protected backend env and Vercel runtime only.
# The URL must use a constrained login granted erp_backend; owner credentials fail startup.
# Migrator credentials belong to a SEPARATE protected migration.env using the same schema/key.
# Do not expose erp_private through Data API; no anon/authenticated/service_role schema grants.
# Attachments stay in encrypted PostgreSQL records; no public Storage bucket is required.
# Set max_locks_per_transaction=512 with the authorized provider tool and restart BEFORE migration.
# Require Vercel deployment protection/private gateway. TLS/host/target checks are unverified.
